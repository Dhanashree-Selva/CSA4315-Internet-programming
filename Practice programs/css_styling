
<!DOCTYPE html>
<html>
<head>
    <title>CSS Styling</title>

    <style>
        body {
            background-color: lightblue;
            font-family: Arial;
            text-align: center;
        }

        h1 {
            color: darkblue;
            background-color: white;
            padding: 20px;
        }

        p {
            color: darkgreen;
            font-size: 20px;
            font-style: italic;
        }

        .box {
            background-color: orange;
            border: 3px solid black;
            padding: 30px;
            margin: 30px;
            border-radius: 15px;
        }

        button {
            background-color: blue;
            color: white;
            padding: 12px;
            border: none;
        }
    </style>
</head>

<body>

    <h1>CSS Styling Example</h1>

    <p>Welcome to Internet Programming Lab</p>

    <div class="box">
        <h2>CSS Properties</h2>
        <p>Color, Background, Border, Margin and Padding</p>
        <button>Click Me</button>
    </div>

</body>
</html>

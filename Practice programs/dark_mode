
<!DOCTYPE html>
<html>
<head>
    <title>Dark Mode</title>

    <style>
        body {
            font-family: Arial;
            text-align: center;
            padding: 50px;
            background-color: white;
            color: black;
        }

        .dark {
            background-color: black;
            color: white;
        }

        button {
            padding: 12px 20px;
            cursor: pointer;
        }
    </style>
</head>

<body id="page">

    <h1>Dark Mode Example</h1>
    <p>Click the button to change the theme.</p>

    <button onclick="changeMode()">Toggle Dark Mode</button>

    <script>
        function changeMode() {
            document.getElementById("page").classList.toggle("dark");
        }
    </script>

</body>
</html>
